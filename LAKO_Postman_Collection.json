{
  "info": {
    "name": "LAKO — Local AI Knowledge Orchestrator",
    "description": "Complete API collection for LAKO — fully on-premises bank knowledge platform.\n\nEndpoint groups:\n• Health & System\n• V1 Chat\n• V1 RAG (ChromaDB)\n• V1 Ingestion\n• V1 Confluence\n• V1 Vector DB\n• Models & Config\n• Dashboard\n• V2 Ingestion (Qdrant + SQLite)\n• V2 RAG\n• V2 Health & Index\n• Gateway (API-key protected)\n• Admin (API keys)\n\nGateway endpoints require the X-API-Key header.\nSet the collection variable `api_key` before using gateway/admin routes.\n\nBase URL: http://localhost:8000",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "lako-api-collection-v2",
    "version": "2.0.0"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000", "type": "string" },
    { "key": "api_key",  "value": "YOUR_API_KEY_HERE",    "type": "string" }
  ],
  "item": [

    {
      "name": "Health & System",
      "item": [
        {
          "name": "Root Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/", "host": ["{{base_url}}"], "path": [""] },
            "description": "Returns 200 OK with a welcome message — confirms the backend is running."
          }
        },
        {
          "name": "Download Postman Collection",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/postman", "host": ["{{base_url}}"], "path": ["postman"] },
            "description": "Downloads this Postman collection as a JSON file."
          }
        },
        {
          "name": "OpenAPI Docs (Swagger UI)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/docs", "host": ["{{base_url}}"], "path": ["docs"] },
            "description": "Interactive Swagger UI for all endpoints."
          }
        },
        {
          "name": "OpenAPI JSON Schema",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/openapi.json", "host": ["{{base_url}}"], "path": ["openapi.json"] },
            "description": "Raw OpenAPI 3.x JSON schema."
          }
        }
      ]
    },

    {
      "name": "V1 Chat",
      "item": [
        {
          "name": "Chat (Streaming)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"prompt\": \"What is LAKO?\",\n  \"model\": null,\n  \"system\": null\n}"
            },
            "url": { "raw": "{{base_url}}/api/chat", "host": ["{{base_url}}"], "path": ["api", "chat"] },
            "description": "Direct streaming chat with the primary Ollama model (no RAG context). Returns Server-Sent Events (text/event-stream). `model` and `system` are optional."
          }
        }
      ]
    },

    {
      "name": "V1 RAG (ChromaDB)",
      "item": [
        {
          "name": "RAG Query (Streaming SSE)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"What is the capital requirement for tier 1 banks?\",\n  \"top_k\": 5,\n  \"model\": null,\n  \"use_web_search\": false\n}"
            },
            "url": { "raw": "{{base_url}}/api/rag/query", "host": ["{{base_url}}"], "path": ["api", "rag", "query"] },
            "description": "V1 RAG query against ChromaDB. Streams answer + citations via SSE (text/event-stream). `model` and `use_web_search` are optional."
          }
        },
        {
          "name": "RAG Query (Sync, no streaming)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"Summarize the liquidity policy.\",\n  \"top_k\": 5,\n  \"model\": null,\n  \"use_web_search\": false\n}"
            },
            "url": { "raw": "{{base_url}}/api/rag/query/sync", "host": ["{{base_url}}"], "path": ["api", "rag", "query", "sync"] },
            "description": "Same as /rag/query but returns complete JSON response (no streaming). Useful for testing."
          }
        },
        {
          "name": "Query Cache Stats",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/api/cache/stats", "host": ["{{base_url}}"], "path": ["api", "cache", "stats"] },
            "description": "Returns V1 query cache stats (hit rate, size, TTL)."
          }
        },
        {
          "name": "Clear Query Cache",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": { "raw": "{{base_url}}/api/cache", "host": ["{{base_url}}"], "path": ["api", "cache"] },
            "description": "Clears the V1 query cache."
          }
        }
      ]
    },

    {
      "name": "V1 Ingestion",
      "item": [
        {
          "name": "Ingest Document(s)",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "files", "type": "file", "src": "/path/to/document.pdf", "description": "One or more files to ingest (PDF, PPTX, DOCX, XLSX)" }
              ]
            },
            "url": { "raw": "{{base_url}}/api/ingest/docs", "host": ["{{base_url}}"], "path": ["api", "ingest", "docs"] },
            "description": "Upload and chunk one or more documents into ChromaDB (V1 pipeline). Supports PDF, PPTX, DOCX, XLSX."
          }
        },
        {
          "name": "Ingestion Status",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/api/ingest/status", "host": ["{{base_url}}"], "path": ["api", "ingest", "status"] },
            "description": "Returns current V1 ingestion job status (idle / running / done / failed)."
          }
        }
      ]
    },

    {
      "name": "V1 Confluence",
      "item": [
        {
          "name": "Ingest Confluence Space",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"space_key\": \"RISK\",\n  \"base_url\": \"https://yourcompany.atlassian.net\",\n  \"username\": \"user@example.com\",\n  \"api_token\": \"your-token\",\n  \"max_pages\": 100\n}"
            },
            "url": { "raw": "{{base_url}}/api/ingest/confluence", "host": ["{{base_url}}"], "path": ["api", "ingest", "confluence"] },
            "description": "Start async ingestion of a Confluence space into ChromaDB. Returns a job_id to poll."
          }
        },
        {
          "name": "Confluence Ingestion Status",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/api/ingest/confluence/status", "host": ["{{base_url}}"], "path": ["api", "ingest", "confluence", "status"] },
            "description": "Poll status of the most recent Confluence ingestion job."
          }
        }
      ]
    },

    {
      "name": "V1 Vector DB (ChromaDB)",
      "item": [
        {
          "name": "Vector DB Status",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/api/vector/status", "host": ["{{base_url}}"], "path": ["api", "vector", "status"] },
            "description": "Returns ChromaDB collection stats: document count, chunk count."
          }
        },
        {
          "name": "Clear Vector DB (V1)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": { "raw": "{{base_url}}/api/vector/clear", "host": ["{{base_url}}"], "path": ["api", "vector", "clear"] },
            "description": "Wipes all V1 ChromaDB data. Irreversible — confirm before use."
          }
        }
      ]
    },

    {
      "name": "Models & Config",
      "item": [
        {
          "name": "List Available Models",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/api/models", "host": ["{{base_url}}"], "path": ["api", "models"] },
            "description": "Returns all Ollama models installed locally with name, size, and modified date."
          }
        },
        {
          "name": "List Chat Models",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/api/models/chat", "host": ["{{base_url}}"], "path": ["api", "models", "chat"] },
            "description": "Returns only the models suitable for chat/RAG (non-embedding, non-vision)."
          }
        },
        {
          "name": "Get Config",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/api/config", "host": ["{{base_url}}"], "path": ["api", "config"] },
            "description": "Returns the current LAKO configuration (primary_model, embedding_model, ollama_url, etc.)."
          }
        },
        {
          "name": "Update Config",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"primary_model\": \"qwen3:14b\",\n  \"summarization_model\": \"qwen2.5:3b\",\n  \"embedding_model\": \"nomic-embed-text\",\n  \"vision_model\": \"llava:latest\",\n  \"ollama_url\": \"http://localhost:11434\",\n  \"qdrant_url\": \"http://localhost:6333\",\n  \"similarity_threshold\": 0.25,\n  \"max_query_cache_size\": 200,\n  \"query_cache_ttl_seconds\": 3600\n}"
            },
            "url": { "raw": "{{base_url}}/api/config", "host": ["{{base_url}}"], "path": ["api", "config"] },
            "description": "Update one or more config fields. Only provided keys are updated; omitted keys retain current values."
          }
        }
      ]
    },

    {
      "name": "Dashboard",
      "item": [
        {
          "name": "Dashboard Stats",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/api/dashboard/stats", "host": ["{{base_url}}"], "path": ["api", "dashboard", "stats"] },
            "description": "Returns aggregated stats for the LAKO dashboard: V1 chunk count, model health, Ollama status."
          }
        },
        {
          "name": "Recent Activity",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/dashboard/recent-activity?limit=20",
              "host": ["{{base_url}}"],
              "path": ["api", "dashboard", "recent-activity"],
              "query": [{ "key": "limit", "value": "20", "description": "Max events to return (default 20)" }]
            },
            "description": "Returns the most recent activity log entries (ingestions, queries, errors) for both V1 and V2."
          }
        }
      ]
    },

    {
      "name": "V2 Ingestion (Qdrant + SQLite)",
      "item": [
        {
          "name": "Ingest Document (V2)",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "file", "type": "file", "src": "/path/to/document.pdf", "description": "Single file to ingest (PDF or PPTX)" }
              ]
            },
            "url": { "raw": "{{base_url}}/api/v2/ingest", "host": ["{{base_url}}"], "path": ["api", "v2", "ingest"] },
            "description": "Upload a single PDF or PPTX into the V2 pipeline (3-pass: extract → summarize → embed into Qdrant). Returns a job_id to poll. Deduplication by SHA-256 is automatic."
          }
        },
        {
          "name": "Ingestion Status (V2)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v2/ingest/:job_id/status",
              "host": ["{{base_url}}"],
              "path": ["api", "v2", "ingest", ":job_id", "status"],
              "variable": [{ "key": "job_id", "value": "your-job-id-here", "description": "UUID returned by POST /v2/ingest" }]
            },
            "description": "Poll V2 ingestion progress. Returns phase (extracting/summarizing/embedding/ready/failed) + current/total page counts."
          }
        },
        {
          "name": "List V2 Documents",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/api/v2/documents", "host": ["{{base_url}}"], "path": ["api", "v2", "documents"] },
            "description": "Returns all documents with status=ready in the V2 SQLite store, including filename, source_type, total_pages, and ingestion timestamp."
          }
        }
      ]
    },

    {
      "name": "V2 RAG (Qdrant)",
      "item": [
        {
          "name": "RAG Query (V2, Streaming SSE)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"What are the capital adequacy requirements?\",\n  \"top_k\": 5,\n  \"model\": null,\n  \"use_web_search\": false,\n  \"filter_doc_ids\": null\n}"
            },
            "url": { "raw": "{{base_url}}/api/v2/query", "host": ["{{base_url}}"], "path": ["api", "v2", "query"] },
            "description": "V2 RAG query against Qdrant page-summary vectors. Supports query decomposition, MMR re-ranking, and optional web search. Streams SSE tokens. `filter_doc_ids` is an optional list of doc UUIDs to restrict search scope."
          }
        }
      ]
    },

    {
      "name": "V2 Health & Index",
      "item": [
        {
          "name": "V2 Collection Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/api/v2/health", "host": ["{{base_url}}"], "path": ["api", "v2", "health"] },
            "description": "Returns Qdrant collection status, points count, and V2 query cache stats."
          }
        },
        {
          "name": "V2 Model Readiness",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/api/v2/ready", "host": ["{{base_url}}"], "path": ["api", "v2", "ready"] },
            "description": "Checks whether the primary model, embedding model, and Qdrant are all ready to serve requests."
          }
        },
        {
          "name": "Reindex Single Document (V2)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v2/reindex/:doc_id",
              "host": ["{{base_url}}"],
              "path": ["api", "v2", "reindex", ":doc_id"],
              "variable": [{ "key": "doc_id", "value": "your-doc-uuid-here", "description": "UUID of the document to re-summarise and re-embed" }]
            },
            "description": "Re-runs Pass 2 (LLM summarisation) and Pass 3 (embedding) for a single document. Useful after a model upgrade. Old Qdrant points are deleted first."
          }
        },
        {
          "name": "Reindex All Documents (V2)",
          "request": {
            "method": "POST",
            "header": [],
            "url": { "raw": "{{base_url}}/api/v2/reindex", "host": ["{{base_url}}"], "path": ["api", "v2", "reindex"] },
            "description": "Rebuilds the entire Qdrant collection from existing SQLite summaries (no LLM calls). Drops and recreates the collection, then re-embeds all summaries."
          }
        },
        {
          "name": "Clear All V2 Data",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": { "raw": "{{base_url}}/api/v2/clear", "host": ["{{base_url}}"], "path": ["api", "v2", "clear"] },
            "description": "Wipes all V2 data: Qdrant collection, SQLite documents/pages/summaries, and the V2 query cache. Irreversible — confirm before use."
          }
        }
      ]
    },

    {
      "name": "Gateway (API-key protected)",
      "item": [
        {
          "name": "Gateway Query",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-API-Key", "value": "{{api_key}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"What is the Basel III capital ratio requirement?\",\n  \"top_k\": 5,\n  \"use_web_search\": false,\n  \"stream\": false\n}"
            },
            "url": { "raw": "{{base_url}}/api/gateway/query", "host": ["{{base_url}}"], "path": ["api", "gateway", "query"] },
            "description": "Authenticated gateway for external applications to query LAKO. Requires X-API-Key header. Routes to V2 RAG by default."
          }
        },
        {
          "name": "Gateway — Ingest Confluence",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-API-Key", "value": "{{api_key}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"space_key\": \"RISK\",\n  \"base_url\": \"https://yourcompany.atlassian.net\",\n  \"username\": \"user@example.com\",\n  \"api_token\": \"your-token\",\n  \"max_pages\": 100\n}"
            },
            "url": { "raw": "{{base_url}}/api/gateway/ingest/confluence", "host": ["{{base_url}}"], "path": ["api", "gateway", "ingest", "confluence"] },
            "description": "Authenticated gateway to trigger Confluence ingestion. Requires X-API-Key."
          }
        },
        {
          "name": "Gateway — Ingest Document",
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-API-Key", "value": "{{api_key}}" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "file", "type": "file", "src": "/path/to/document.pdf" }
              ]
            },
            "url": { "raw": "{{base_url}}/api/gateway/ingest/document", "host": ["{{base_url}}"], "path": ["api", "gateway", "ingest", "document"] },
            "description": "Authenticated gateway to upload and ingest a document (routes to V2 pipeline). Requires X-API-Key."
          }
        },
        {
          "name": "Gateway Health",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-API-Key", "value": "{{api_key}}" }
            ],
            "url": { "raw": "{{base_url}}/api/gateway/health", "host": ["{{base_url}}"], "path": ["api", "gateway", "health"] },
            "description": "Health check for the gateway subsystem. Requires X-API-Key."
          }
        }
      ]
    },

    {
      "name": "Admin (API Keys)",
      "item": [
        {
          "name": "Create API Key",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"CI Pipeline Key\",\n  \"expires_in_days\": 90\n}"
            },
            "url": { "raw": "{{base_url}}/api/admin/keys", "host": ["{{base_url}}"], "path": ["api", "admin", "keys"] },
            "description": "Create a new API key for gateway access. Returns the raw key once — store it securely. `expires_in_days` is optional."
          }
        },
        {
          "name": "List API Keys",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/api/admin/keys", "host": ["{{base_url}}"], "path": ["api", "admin", "keys"] },
            "description": "List all API keys with metadata (id, name, created_at, expires_at, revoked). Raw key values are never returned."
          }
        },
        {
          "name": "Delete API Key",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/admin/keys/:key_id",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "keys", ":key_id"],
              "variable": [{ "key": "key_id", "value": "key-uuid-here" }]
            },
            "description": "Permanently delete an API key by its ID."
          }
        },
        {
          "name": "Revoke API Key",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/admin/keys/:key_id/revoke",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "keys", ":key_id", "revoke"],
              "variable": [{ "key": "key_id", "value": "key-uuid-here" }]
            },
            "description": "Revoke an API key (marks it inactive without deleting). The key will no longer be accepted by the gateway."
          }
        }
      ]
    }

  ]
}
