    {
      "name": "8. Admin — API Key Management",
      "description": "⚠️  Admin endpoints — no authentication required.\nIn production these are firewalled to localhost / admin VLAN only.\n\nManage API keys: create, list, revoke, delete.",
      "item": [
        {
          "name": "Create API Key",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Integration Key\",\n  \"permissions\": [\"query\", \"ingest\"]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/admin/keys",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "keys"]
            },
            "description": "Generate a new API key.\n\n⚠️  The full key is returned ONCE and never stored. Copy it immediately.\n\nPermissions:\n- 'query'  → allows POST /api/gateway/query\n- 'ingest' → allows POST /api/gateway/ingest/*\n\nBoth permissions can be granted together: [\"query\", \"ingest\"]"
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "header": [{"key": "Content-Type", "value": "application/json"}],
              "body": "{\n  \"key\": \"lako_AbCdEfGhIjKlMnOpQrStUvWxYz1234567890abcdef\",\n  \"id\": \"a1b2c3d4-1234-5678-abcd-ef0123456789\",\n  \"prefix\": \"lako_AbCdEf\",\n  \"warning\": \"Save this key immediately. It will never be shown again.\"\n}"
            }
          ]
        },
        {
          "name": "List API Keys",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/admin/keys",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "keys"]
            },
            "description": "List all API keys — shows metadata only (no full key values, no hashes)."
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "header": [{"key": "Content-Type", "value": "application/json"}],
              "body": "[\n  {\n    \"id\": \"a1b2c3d4-1234-5678-abcd-ef0123456789\",\n    \"name\": \"Postman Integration Key\",\n    \"prefix\": \"lako_QgB4rN\",\n    \"created_at\": \"2026-04-01T08:00:00Z\",\n    \"last_used\": \"2026-04-01T10:30:00Z\",\n    \"is_active\": true,\n    \"permissions\": [\"query\", \"ingest\"]\n  }\n]"
            }
          ]
        },
        {
          "name": "Revoke API Key",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/admin/keys/KEY_ID_HERE/revoke",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "keys", "KEY_ID_HERE", "revoke"]
            },
            "description": "Revoke an API key — marks it inactive but keeps the record for audit purposes.\n\nReplace KEY_ID_HERE with the key's id from List API Keys."
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "header": [{"key": "Content-Type", "value": "application/json"}],
              "body": "{\n  \"revoked\": true,\n  \"id\": \"a1b2c3d4-1234-5678-abcd-ef0123456789\"\n}"
            }
          ]
        },
        {
          "name": "Delete API Key ⚠️",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/admin/keys/KEY_ID_HERE",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "keys", "KEY_ID_HERE"]
            },
            "description": "Permanently delete an API key by ID.\n\n⚠️  Irreversible. The key can no longer be used.\n\nReplace KEY_ID_HERE with the key's id from List API Keys."
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "header": [{"key": "Content-Type", "value": "application/json"}],
              "body": "{\n  \"deleted\": true,\n  \"id\": \"a1b2c3d4-1234-5678-abcd-ef0123456789\"\n}"
            }
          ]
        }
      ]
    }

