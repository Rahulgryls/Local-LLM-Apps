# LAKO — Git Ignore

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
backend/.venv/
backend/venv/
*.egg-info/
dist/
build/
.eggs/

# Node
frontend/node_modules/
frontend/dist/
frontend/.vite/

# Storage — never commit data or DB
storage/chromadb/*
storage/uploads/*
!storage/chromadb/.gitkeep
!storage/uploads/.gitkeep

# Config — keep template but NOT credentials
# config/config.json is committed as template with empty credentials

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log
uvicorn*.log
